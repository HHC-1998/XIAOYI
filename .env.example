# 复制为 .env 后修改
DB_PASSWORD=xiaoyi_pass
NEO4J_USER=neo4j
NEO4J_PASSWORD=xiaoyi_pass

# 本地固定模型（env 写死，见 06 §4）：全部走本地 Ollama，不接任何云端 API。
# base_url 默认 localhost:11434；后端在 Docker 容器内会自动解析为宿主机地址。
XIAOYI_OLLAMA_BASE_URL=http://localhost:11434
XIAOYI_CHAT_MODEL=xiaoyi           # 本地微调说话风格模型（Ollama 模型名须小写，见 10_文档）
XIAOYI_EXTRACT_MODEL=qwen3:0.6b  # 本地千问指令模型（记忆抽取 / 三元组审核；2026-09-04 由 4b 降回：4G 显存三方互踢，见台账 41 节）
XIAOYI_EMBEDDING_MODEL=bge-m3       # 本地 bge（向量化）

# TTS（04 §9）：edge-tts 在线合成（晓伊 +10%，2026-09-03 用户试听选定，元气活泼更贴人设）。
# TTS 是「不接云端 API」的唯一有意例外；想回晓晓改 zh-CN-XiaoxiaoNeural / +0%。
XIAOYI_TTS_VOICE=zh-CN-XiaoyiNeural
XIAOYI_TTS_RATE=+10%
XIAOYI_TTS_PITCH=+0Hz

# 可选：生产环境请务必修改 JWT 密钥
# JWT_SECRET=change-me-to-a-random-string
